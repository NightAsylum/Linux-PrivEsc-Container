#!/bin/sh
### BEGIN INIT INFO
# Provides:          PyWeb
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Lab web service
### END INIT INFO

DAEMON=/usr/bin/python3
SCRIPT=/usr/local/bin/webserver.py
PIDFILE=/var/run/PyWeb.py
LOGFILE=/var/log/PyWeb.log

case "$1" in
    start)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "PyWeb already running"
            exit 0
        fi

        echo "Starting PyWeb..."
        nohup "$DAEMON" "$SCRIPT" >>"$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        ;;

    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
            rm -f "$PIDFILE"
            echo "Stopped."
        fi
        ;;

    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;

    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "Running (PID $(cat "$PIDFILE"))"
        else
            echo "PyWeb Not running"
            exit 1
        fi
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0